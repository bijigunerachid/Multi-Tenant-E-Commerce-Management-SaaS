# Production settings for docker-compose.prod.yml. Copy to .env.production (never committed)
# and replace every value. Generate passwords with: openssl rand -base64 32 | tr -d '/+='
# The API refuses to start if a required value is missing or unsafe (see backend/src/config/env.js).

# Public address of the site. Caddy gets an HTTPS certificate for it automatically once the
# domain's DNS points at this server. APP_URL and CORS_ORIGINS must be the same https origin.
SITE_ADDRESS=app.example.com
APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Database and Redis (private to the server; the API's URLs are built from these).
POSTGRES_USER=vendora
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=vendora
REDIS_PASSWORD=replace-with-another-long-random-password

# Email: a real SMTP provider (Postmark, Amazon SES, Mailgun...). smtps:// for implicit TLS on
# port 465; smtp:// on 587 upgrades with STARTTLS.
MAIL_TRANSPORT=smtp
SMTP_URL=smtps://username:password@smtp.example.com:465
MAIL_FROM=Vendora <no-reply@example.com>

# Payments. "none" keeps trials and limits; plans cannot be bought until Stripe is set up.
# With "stripe": a live restricted key, and the signing secret of the webhook endpoint
# https://<your domain>/api/v1/subscriptions/webhooks/stripe created in the Stripe Dashboard.
BILLING_PROVIDER=none
# STRIPE_SECRET_KEY=rk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Encrypts two-factor (authenticator) secrets in the database: openssl rand -base64 32
# Keep it with your backups: without it, everyone with two-factor on must have it reset.
MFA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

LOG_LEVEL=info

# Optional: other host ports (for example to test this stack next to development).
# HTTP_PORT=80
# HTTPS_PORT=443
