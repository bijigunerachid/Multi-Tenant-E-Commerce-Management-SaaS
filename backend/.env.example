# Copy to backend/.env. The passwords must match the root .env used by Docker Compose.
# Use 127.0.0.1 rather than localhost: Docker publishes the ports on IPv4 only, and on
# Windows "localhost" tries IPv6 first, which adds about 2 seconds to every new connection.
NODE_ENV=development
PORT=4100
LOG_LEVEL=info

DATABASE_URL=postgresql://vendora:change-me-postgres@127.0.0.1:5434/vendora
# Tests run against this database. It is created by docker/postgres/init on first start.
TEST_DATABASE_URL=postgresql://vendora:change-me-postgres@127.0.0.1:5434/vendora_test

REDIS_URL=redis://:change-me-redis@127.0.0.1:6380/0
# Tests use a separate Redis database number so they never flush development data.
TEST_REDIS_URL=redis://:change-me-redis@127.0.0.1:6380/1

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Public address of the web app (used in links inside emails).
APP_URL=http://localhost:5173

# Sessions: idle timeout in minutes, absolute lifetime in days.
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_DAYS=7

# Email. Locally, Mailpit catches everything: open http://localhost:8025 to read it.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Vendora <no-reply@vendora.local>
# Emails and notifications are handled by a worker: `npm run worker` (started by
# `npm run dev`). Set to in-process to let the API run the worker itself instead.
# JOB_WORKER=separate
# First retry delay in milliseconds; each retry waits twice as long (5 attempts).
# EMAIL_RETRY_DELAY_MS=30000
# How often pending notifications (new orders, low stock) are delivered, in milliseconds.
# NOTIFICATION_POLL_MS=5000

# Payments for Vendora plans (see docs/architecture.md, "Payments"). "none" keeps trials and
# limits but nothing can be bought. For Stripe test mode: put a test key below (a restricted
# rk_test_ key is recommended), run `npm run stripe:setup -w backend`, then
# `npm run stripe:listen -w backend` and copy the whsec_ secret it prints.
# BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Multiplies every rate limit. Only for test runs that create many accounts from one address
# (the Playwright suite uses 20). Must be 1 in production; the API refuses to start otherwise.
# RATE_LIMIT_SCALE=1

# Uploaded product images (local development storage, git-ignored).
UPLOAD_DIR=uploads
