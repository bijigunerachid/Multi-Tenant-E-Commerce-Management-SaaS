// Vendora database schema. See docs/data-model.md for the full design and invariants.
// Conventions: UUID keys generated by PostgreSQL, snake_case tables and columns,
// timestamptz (UTC) timestamps, Restrict as the default delete behaviour.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  NONE
  SUPER_ADMIN

  @@map("platform_role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED

  @@map("organization_status")
}

enum MemberRole {
  OWNER
  MANAGER
  INVENTORY_MANAGER
  ORDER_MANAGER
  ANALYST

  @@map("member_role")
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED

  @@map("membership_status")
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET

  @@map("auth_token_purpose")
}

enum StoreStatus {
  ACTIVE
  ARCHIVED

  @@map("store_status")
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT
  RESERVE
  RELEASE
  FULFIL

  @@map("inventory_movement_type")
}

enum AdjustmentReason {
  COUNT_CORRECTION
  DAMAGED
  LOST
  FOUND
  RETURNED
  OTHER

  @@map("adjustment_reason")
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED

  @@map("reservation_status")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

/// A person who can sign in. Not tenant-owned: tenant access comes from memberships.
/// Emails are stored lower-cased; a CHECK constraint in the migration enforces it,
/// so the unique index is effectively case-insensitive.
model User {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String       @unique @db.VarChar(254)
  passwordHash             String       @map("password_hash")
  name                     String       @db.VarChar(120)
  emailVerifiedAt          DateTime?    @map("email_verified_at") @db.Timestamptz(3)
  platformRole             PlatformRole @default(NONE) @map("platform_role")
  status                   UserStatus   @default(ACTIVE)
  /// Restored as the active organization at login. Membership is re-checked on every request.
  lastActiveOrganizationId String?      @map("last_active_organization_id") @db.Uuid
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  lastActiveOrganization Organization?            @relation("UserLastActiveOrganization", fields: [lastActiveOrganizationId], references: [id], onDelete: SetNull)
  memberships            OrganizationMembership[] @relation("MembershipUser")
  invitedMemberships     OrganizationMembership[] @relation("MembershipInvitedBy")
  authTokens             AuthToken[]
  sentInvitations        Invitation[]             @relation("InvitationInvitedBy")

  @@map("users")
}

/// Single-use email verification and password reset tokens. Only a SHA-256 hash is stored.
model AuthToken {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// A tenant. Never hard-deleted by the application (see docs/data-model.md).
model Organization {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String             @db.VarChar(120)
  slug            String             @unique @db.VarChar(60)
  status          OrganizationStatus @default(ACTIVE)
  suspendedAt     DateTime?          @map("suspended_at") @db.Timestamptz(3)
  suspendedReason String?            @map("suspended_reason") @db.VarChar(500)
  defaultCurrency String             @default("USD") @map("default_currency") @db.Char(3)
  timezone        String             @default("UTC") @db.VarChar(64)
  contactEmail    String?            @map("contact_email") @db.VarChar(254)
  contactPhone    String?            @map("contact_phone") @db.VarChar(40)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships        OrganizationMembership[]
  invitations        Invitation[]
  stores             Store[]
  auditLogs          AuditLog[]
  ownershipTransfer  OwnershipTransfer?
  lastActiveForUsers User[]                   @relation("UserLastActiveOrganization")
  categories         Category[]
  products           Product[]
  productVariants    ProductVariant[]
  productImages      ProductImage[]
  inventoryLevels    InventoryLevel[]
  inventoryMovements InventoryMovement[]
  customers          Customer[]
  addresses          Address[]
  orders             Order[]
  orderItems         OrderItem[]
  orderStatusHistory OrderStatusHistory[]
  reservations       InventoryReservation[]
  counter            OrganizationCounter?

  @@map("organizations")
}

/// Links a user to an organization with one role. Tenant-owned.
model OrganizationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MemberRole
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  invitedBy    User?        @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  ownershipTransfersTo   OwnershipTransfer[] @relation("TransferTarget")
  ownershipTransfersFrom OwnershipTransfer[] @relation("TransferSource")

  @@unique([userId, organizationId])
  @@unique([organizationId, id])
  @@index([organizationId, role, status])
  @@map("organization_memberships")
}

/// An invitation to join an organization. The token is emailed; only its SHA-256 is stored.
/// `pendingEmail` equals `email` while the invitation is pending and is NULL once accepted or
/// revoked, so the unique constraint allows only one pending invitation per email and org.
model Invitation {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  email          String     @db.VarChar(254)
  pendingEmail   String?    @map("pending_email") @db.VarChar(254)
  role           MemberRole
  tokenHash      String     @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?  @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime?  @map("revoked_at") @db.Timestamptz(3)
  invitedById    String     @map("invited_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, pendingEmail])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("invitations")
}

/// At most one pending ownership transfer per organization (the organization id is the key).
/// The row is removed when the transfer is accepted, cancelled or found expired; the audit log
/// keeps the history.
model OwnershipTransfer {
  organizationId   String   @id @map("organization_id") @db.Uuid
  fromMembershipId String   @map("from_membership_id") @db.Uuid
  toMembershipId   String   @map("to_membership_id") @db.Uuid
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fromMembership OrganizationMembership @relation("TransferSource", fields: [organizationId, fromMembershipId], references: [organizationId, id], onDelete: Cascade)
  toMembership   OrganizationMembership @relation("TransferTarget", fields: [organizationId, toMembershipId], references: [organizationId, id], onDelete: Cascade)

  @@map("ownership_transfers")
}

/// A physical or online store of an organization. Inventory is tracked per store.
model Store {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String      @db.VarChar(120)
  slug           String      @db.VarChar(60)
  currency       String      @db.Char(3)
  timezone       String      @db.VarChar(64)
  status         StoreStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventoryLevels InventoryLevel[]
  orders          Order[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@map("stores")
}

/// Append-only record of security-relevant actions. UPDATE and DELETE are blocked by a trigger.
/// `organizationId` is NULL for platform-level and pre-tenant events (for example login).
model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(80)
  entityType     String?  @map("entity_type") @db.VarChar(60)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  metadata       Json?
  ip             String?  @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(300)
  requestId      String?  @map("request_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Product category. Categories can be nested; the parent must belong to the same organization
/// (composite foreign key). A category with products or child categories cannot be deleted.
model Category {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String   @db.VarChar(120)
  slug           String   @db.VarChar(60)
  description    String?  @db.VarChar(1000)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       Category?    @relation("CategoryTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children     Category[]   @relation("CategoryTree")
  products     Product[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@index([organizationId, parentId])
  @@map("categories")
}

/// A product. Prices, SKUs and stock live on its variants; every product has at least one.
model Product {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  categoryId     String?       @map("category_id") @db.Uuid
  name           String        @db.VarChar(200)
  description    String?       @db.VarChar(5000)
  status         ProductStatus @default(DRAFT)
  archivedAt     DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     Category?        @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  variants     ProductVariant[]
  images       ProductImage[]

  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([organizationId, categoryId])
  @@map("products")
}

/// A sellable unit (for example size M, colour red). SKUs are unique within an organization,
/// stored upper-cased. Money is Decimal(12,2) with an explicit ISO 4217 currency.
model ProductVariant {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  sku               String   @db.VarChar(64)
  name              String   @db.VarChar(120)
  /// Option values, for example {"size": "M", "color": "Red"}.
  options           Json     @default("{}")
  price             Decimal  @db.Decimal(12, 2)
  cost              Decimal? @db.Decimal(12, 2)
  currency          String   @db.Char(3)
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  position          Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product         Product          @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  inventoryLevels InventoryLevel[]
  orderItems      OrderItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, id])
  @@index([organizationId, productId])
  @@map("product_variants")
}

/// Product image metadata. The file itself is kept by the storage provider under storageKey.
model ProductImage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  storageKey     String   @unique @map("storage_key") @db.VarChar(200)
  mimeType       String   @map("mime_type") @db.VarChar(40)
  sizeBytes      Int      @map("size_bytes")
  altText        String?  @map("alt_text") @db.VarChar(300)
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, productId, position])
  @@map("product_images")
}

/// Stock of one variant in one store. Created on the first stock movement. available =
/// onHand - reserved. CHECK constraints keep onHand >= 0, reserved >= 0 and reserved <= onHand.
/// Quantities only change through conditional UPDATEs in the inventory service, each paired
/// with an InventoryMovement row in the same transaction.
model InventoryLevel {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  onHand         Int      @default(0) @map("on_hand")
  reserved       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  store        Store                  @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)
  variant      ProductVariant         @relation(fields: [organizationId, variantId], references: [organizationId, id], onDelete: Restrict)
  movements    InventoryMovement[]
  reservations InventoryReservation[]

  @@unique([organizationId, storeId, variantId])
  @@unique([organizationId, id])
  @@index([organizationId, variantId])
  @@map("inventory_levels")
}

/// Append-only history of every stock change (UPDATE and DELETE are blocked by a trigger).
/// Deltas and the resulting quantities are recorded, so the history can be audited and replayed.
model InventoryMovement {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  inventoryLevelId String                @map("inventory_level_id") @db.Uuid
  type             InventoryMovementType
  onHandDelta      Int                   @map("on_hand_delta")
  reservedDelta    Int                   @map("reserved_delta")
  onHandAfter      Int                   @map("on_hand_after")
  reservedAfter    Int                   @map("reserved_after")
  reason           AdjustmentReason?
  note             String?               @db.VarChar(500)
  actorUserId      String?               @map("actor_user_id") @db.Uuid
  /// Set for movements caused by an order (reserve, release, fulfil).
  orderId          String?               @map("order_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventoryLevel InventoryLevel @relation(fields: [organizationId, inventoryLevelId], references: [organizationId, id], onDelete: Restrict)
  order          Order?         @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, inventoryLevelId, createdAt(sort: Desc)])
  @@index([organizationId, orderId])
  @@map("inventory_movements")
}

/// A customer of the organization (the tenant's own buyers, not platform users).
/// Email is optional (walk-in customers), stored lower-cased, and unique per organization when
/// present (PostgreSQL treats NULLs as distinct in unique indexes).
model Customer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(160)
  email          String?   @db.VarChar(254)
  phone          String?   @db.VarChar(40)
  notes          String?   @db.VarChar(2000)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  addresses    Address[]
  orders       Order[]

  @@unique([organizationId, email])
  @@unique([organizationId, id])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, name])
  @@map("customers")
}

/// A customer address. `defaultForCustomerId` equals customerId on the default address and is
/// NULL otherwise, so the unique constraint allows at most one default per customer.
model Address {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  customerId           String   @map("customer_id") @db.Uuid
  defaultForCustomerId String?  @unique @map("default_for_customer_id") @db.Uuid
  label                String?  @db.VarChar(60)
  recipientName        String?  @map("recipient_name") @db.VarChar(160)
  line1                String   @db.VarChar(200)
  line2                String?  @db.VarChar(200)
  city                 String   @db.VarChar(120)
  region               String?  @db.VarChar(120)
  postalCode           String?  @map("postal_code") @db.VarChar(20)
  country              String   @db.Char(2)
  phone                String?  @db.VarChar(40)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, customerId])
  @@map("addresses")
}

/// Per-organization sequence for human-readable order numbers. Incremented atomically
/// (INSERT ... ON CONFLICT DO UPDATE ... RETURNING) when an order is placed.
model OrganizationCounter {
  organizationId  String @id @map("organization_id") @db.Uuid
  lastOrderNumber Int    @default(0) @map("last_order_number")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("organization_counters")
}

/// A sales order. Totals are computed by the server only:
///   subtotal = sum of line totals; tax = round((subtotal - discount) x taxRate, 2);
///   total = subtotal - discount + tax + shipping (CHECK constraint).
/// `number` is assigned when the order is placed (drafts have none), unique per organization.
model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  storeId         String      @map("store_id") @db.Uuid
  customerId      String?     @map("customer_id") @db.Uuid
  number          Int?
  status          OrderStatus @default(DRAFT)
  currency        String      @db.Char(3)
  subtotal        Decimal     @db.Decimal(12, 2)
  discountTotal   Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxRate         Decimal     @default(0) @map("tax_rate") @db.Decimal(6, 4)
  taxTotal        Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  shippingTotal   Decimal     @default(0) @map("shipping_total") @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  /// Snapshots taken when the order is written, so later profile edits do not rewrite history.
  customerName    String?     @map("customer_name") @db.VarChar(160)
  customerEmail   String?     @map("customer_email") @db.VarChar(254)
  shippingAddress Json?       @map("shipping_address")
  notes           String?     @db.VarChar(1000)
  cancelReason    String?     @map("cancel_reason") @db.VarChar(500)
  createdById     String?     @map("created_by_id") @db.Uuid
  placedAt        DateTime?   @map("placed_at") @db.Timestamptz(3)
  shippedAt       DateTime?   @map("shipped_at") @db.Timestamptz(3)
  deliveredAt     DateTime?   @map("delivered_at") @db.Timestamptz(3)
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  store        Store                @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)
  customer     Customer?            @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  items        OrderItem[]
  history      OrderStatusHistory[]
  movements    InventoryMovement[]

  @@unique([organizationId, number])
  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([organizationId, customerId])
  @@index([organizationId, placedAt(sort: Desc)])
  // Reports and the dashboard select sales by ship date.
  @@index([organizationId, shippedAt])
  @@map("orders")
}

/// An order line. Product name, variant name, SKU and unit price are copied from the catalog
/// when the line is written, so historical orders stay accurate after catalog changes.
model OrderItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  productName    String   @map("product_name") @db.VarChar(200)
  variantName    String   @map("variant_name") @db.VarChar(120)
  sku            String   @db.VarChar(64)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity       Int
  lineTotal      Decimal  @map("line_total") @db.Decimal(12, 2)
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        Order                 @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)
  variant      ProductVariant        @relation(fields: [organizationId, variantId], references: [organizationId, id], onDelete: Restrict)
  reservation  InventoryReservation?

  @@unique([organizationId, id])
  @@unique([orderId, variantId])
  @@index([organizationId, variantId])
  @@map("order_items")
}

/// Append-only record of every status change (UPDATE and DELETE are blocked by a trigger).
model OrderStatusHistory {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  fromStatus     OrderStatus? @map("from_status")
  toStatus       OrderStatus  @map("to_status")
  note           String?      @db.VarChar(500)
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        Order        @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, orderId, createdAt])
  @@map("order_status_history")
}

/// Stock held for one order line. Status only moves ACTIVE -> RELEASED (cancelled) or
/// ACTIVE -> CONSUMED (shipped), guarded by WHERE status = 'ACTIVE' so it cannot happen twice.
/// Invariant: for every inventory level, reserved = sum of quantity of its ACTIVE reservations.
model InventoryReservation {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  orderItemId      String            @map("order_item_id") @db.Uuid
  inventoryLevelId String            @map("inventory_level_id") @db.Uuid
  quantity         Int
  status           ReservationStatus @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderItem      OrderItem      @relation(fields: [organizationId, orderItemId], references: [organizationId, id], onDelete: Restrict)
  inventoryLevel InventoryLevel @relation(fields: [organizationId, inventoryLevelId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, orderItemId])
  @@index([organizationId, inventoryLevelId, status])
  @@map("inventory_reservations")
}
