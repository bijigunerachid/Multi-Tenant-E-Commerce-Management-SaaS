{
  "name": "@vendora/backend",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --env-file-if-exists=.env --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "multer": "2.4.0",
    "nodemailer": "10.1.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "jest": "30.5.2",
    "prisma": "6.19.3",
    "supertest": "7.3.1"
  }
}
